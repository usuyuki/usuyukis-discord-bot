# Discord Developer PortalでBotに発行されたトークン
DISCORD_BOT_TOKEN=

# PostgreSQL接続文字列。docker-compose利用時はサービス名postgresをホストにする
DATABASE_URL=postgres://discordbot:${POSTGRES_PASSWORD}@postgres:5432/discordbot?sslmode=disable

# docker-composeのpostgresサービスに設定するパスワード
POSTGRES_PASSWORD=changeme

# 管理画面（認証なし・localhost限定公開）がリッスンするポート
ADMIN_PORT=8080

# devモード。trueにするとDEV_CHANNEL_IDで指定したチャンネル以外の投稿に
# Botの全ハンドラが反応しなくなる（動作確認用サーバーでの誤爆防止）
DEV_MODE=false

# DEV_MODE=trueのときに唯一反応させるチャンネルのID。DEV_MODE=trueの場合は必須
DEV_CHANNEL_ID=
